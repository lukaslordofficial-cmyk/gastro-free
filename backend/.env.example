# =============================================================================
# Backend FastAPI — skopiuj do backend/.env (NIGDY nie commituj .env)
# Railway: te same nazwy w Variables.
# =============================================================================

# --- Core ---
OPENAI_API_KEY=sk-...
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_INSPIRATIONS_MODEL=gpt-4o
OPENAI_TIMEOUT_S=90

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...
# opcjonalnie (health / fallback)
SUPABASE_ANON_KEY=eyJ...anon...

# Fallback gdy brak nagłówka X-Account-Key (apka zalogowana zawsze wysyła klucz)
ACCOUNT_KEY=default

# Publiczny HTTPS API (Railway) — wymagany do Stripe Checkout return / allowlist
PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app
BACKEND_PUBLIC_URL=https://YOUR-SERVICE.up.railway.app
NEXT_PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app
# NIE ustawiaj PUBLIC_APP_URL na localhost:8081 w produkcji
PUBLIC_APP_URL=

# Cron / admin (GET /api/admin/migration-status, expiry jobs)
CRON_JOB_SECRET=long-random-string

# POS webhook HMAC
POS_WEBHOOK_SECRET=long-random-string

# --- Stripe ---
# Beta: sk_test_ / pk_test_
# Live: sk_live_ / pk_live_ + NOWE Price ID z produktów live (nie kopiuj testowych)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TIER1=price_...
STRIPE_PRICE_TIER2=price_...
STRIPE_PRICE_TOPUP_100=price_...
STRIPE_PRICE_TOPUP_500=price_...
STRIPE_PRICE_TOPUP_1000=price_...

# Produkcja: zawsze false. Testowe Price ID tylko lokalnie.
ALLOW_MOCK_BILLING=false
ALLOW_STRIPE_TEST_PRICE_FALLBACK=false

# Opcjonalne nadpisania (domyślnie PUBLIC_API_URL/api/billing/billing-return)
# BILLING_SUCCESS_URL=
# BILLING_CANCEL_URL=

# --- Mail / logistyka (opcjonalnie) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=asystent.dostaw@gastromanager.org
FURGONETKA_SHOP_TOKEN=
INPOST_API_TOKEN=
INPOST_ORGANIZATION_ID=
INPOST_SANDBOX=true

# --- Flags ---
AUTO_CONFIRM_EMAIL=false
DEAL_HUNTER_ENABLED=true
LP_MARKETPLACE_ENABLED=true
MAX_UPLOAD_BYTES=12582912
CORS_ALLOW_ORIGINS=
# CORS_ALLOW_STAR=true   # tylko closed beta
