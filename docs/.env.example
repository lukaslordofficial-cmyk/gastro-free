# Backend — skopiuj do .env i uzupełnij wartości
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Single-tenant beta key (subscriptions / credits). Change per restaurant deploy.
ACCOUNT_KEY=default
# Closed beta only. Store / production MUST stay false.
AUTO_CONFIRM_EMAIL=false
# Optional: comma-separated origins (* = mobile APK without Origin header)
CORS_ALLOW_ORIGINS=*

# Scheduler jobs (expiry, core-alerts, migration-status). Required in production.
# Wymyślasz sam (losowy string) — ten sam na Railway. Header: X-Cron-Secret
CRON_JOB_SECRET=

# POS webhook. Master secret tylko na backendzie (Railway).
# Restaurator kopiuje GOTOWY link z Ustawień (account + HMAC token w URL).
POS_WEBHOOK_SECRET=

# Backend → panel WWW (VAT RR). Ten sam string na Railway I na Vercel (landing).
INTERNAL_API_SECRET=

# Publiczny URL tego API (Railway), żeby Ustawienia budowały poprawny webhook.
# BACKEND_PUBLIC_URL=https://your-api.up.railway.app

# Nigdy na produkcji. Pozwala na testowe Price ID Stripe w kodzie.
# ALLOW_STRIPE_TEST_PRICE_FALLBACK=true

# Stripe (TEST lub LIVE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TIER1=price_...
STRIPE_PRICE_TIER2=price_...
STRIPE_PRICE_TOPUP_100=price_...
STRIPE_PRICE_TOPUP_500=price_...
STRIPE_PRICE_TOPUP_1000=price_...

PUBLIC_APP_URL=http://localhost:8081
BILLING_SUCCESS_URL=http://localhost:8081/billing-success
BILLING_CANCEL_URL=http://localhost:8081/billing-cancel
ALLOW_MOCK_BILLING=false

# Powiadomienia po opłaceniu zamówienia LP (dystrybutor)
RESEND_API_KEY=
# From MUSI być domeną zweryfikowaną w Resend (Gmail/Outlook odpada).
RESEND_FROM_EMAIL=asystent.dostaw@gastromanager.org
RESEND_FROM_NAME=Gastro Manager
SMSAPI_TOKEN=
SMSAPI_FROM=GastroMgr
# SMS_PROVIDER=smsapi

# Furgonetka REST API (konto platformy — prepaid / skarbonka). NIE wkładaj do apki/WWW.
# Panel dystrybutora bierze FURGONETKA_* z Vercel (landing) — patrz docs/FURGONETKA.md.
# TEST: konto https://sandbox.furgonetka.pl + OAuth2 Client ID/Secret + email/hasło.
FURGONETKA_SANDBOX=1
FURGONETKA_MOCK=0
# FURGONETKA_PRODUCTION=1   # tylko na żywo
# Integracja „Własna” (Furgonetka woła GET {base}/orders). Token wklejasz w panelu Furgonetki.
# Bez wartości backend używa tokenu sandbox gm_furg_shop_7c9e4a2b18f04d6e9a51c3b8d0e27f14
# FURGONETKA_SHOP_TOKEN=
# FURGONETKA_CLIENT_ID=
# FURGONETKA_CLIENT_SECRET=
# FURGONETKA_EMAIL=
# FURGONETKA_PASSWORD=
# Host API zawsze api.furgonetka.pl (sandbox I produkcja). NIE api.sandbox.furgonetka.pl.
# FURGONETKA_API_URL=https://api.furgonetka.pl
# Produkcja: FURGONETKA_SANDBOX=0 FURGONETKA_PRODUCTION=1 + klucze z furgonetka.pl
# FURGONETKA_INPOST_SERVICE_ID=
# FURGONETKA_LABEL_PAGE=a6
# LP_PARCEL_S_KG=5
# LP_PARCEL_M_KG=15
# LP_PARCEL_L_KG=25
# LP_PARCEL_MAX_KG=25

