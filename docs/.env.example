# Backend — skopiuj do .env i uzupełnij wartości
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Single-tenant beta key (subscriptions / credits). Change per restaurant deploy.
ACCOUNT_KEY=default
# Optional: comma-separated origins; server currently allows * via CORSMiddleware
CORS_ALLOW_ORIGINS=*

# Stripe (TEST lub LIVE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TIER1=price_...
STRIPE_PRICE_TIER2=price_...
STRIPE_PRICE_TOPUP_100=price_...
STRIPE_PRICE_TOPUP_500=price_...
STRIPE_PRICE_TOPUP_1000=price_...

PUBLIC_APP_URL=http://localhost:8081
BILLING_SUCCESS_URL=http://localhost:8081/billing-success
BILLING_CANCEL_URL=http://localhost:8081/billing-cancel
ALLOW_MOCK_BILLING=false
