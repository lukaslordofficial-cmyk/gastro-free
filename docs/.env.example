# Backend — skopiuj do .env i uzupełnij wartości
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Single-tenant beta key (subscriptions / credits). Change per restaurant deploy.
ACCOUNT_KEY=default
# Optional: comma-separated origins; server currently allows * via CORSMiddleware
CORS_ALLOW_ORIGINS=*

# Stripe (TEST lub LIVE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TIER1=price_...
STRIPE_PRICE_TIER2=price_...
STRIPE_PRICE_TOPUP_100=price_...
STRIPE_PRICE_TOPUP_500=price_...
STRIPE_PRICE_TOPUP_1000=price_...

PUBLIC_APP_URL=http://localhost:8081
BILLING_SUCCESS_URL=http://localhost:8081/billing-success
BILLING_CANCEL_URL=http://localhost:8081/billing-cancel
ALLOW_MOCK_BILLING=false

# Powiadomienia po opłaceniu zamówienia LP (dystrybutor)
RESEND_API_KEY=
# From MUSI być domeną zweryfikowaną w Resend (Gmail/Outlook odpada).
RESEND_FROM_EMAIL=asystent.dostaw@gastromanager.org
RESEND_FROM_NAME=Gastro Manager
SMSAPI_TOKEN=
SMSAPI_FROM=GastroMgr
# SMS_PROVIDER=smsapi

# Furgonetka REST API (konto platformy — prepaid / skarbonka). NIE wkładaj do apki/WWW.
# TEST bez firmy: sandbox + mock (pełny flow, kurier nie jedzie na serio).
FURGONETKA_SANDBOX=1
FURGONETKA_MOCK=1
# Integracja „Własna” (Furgonetka woła GET {base}/orders). Token wklejasz w panelu Furgonetki.
# Bez wartości backend używa tokenu sandbox gm_furg_shop_7c9e4a2b18f04d6e9a51c3b8d0e27f14
# FURGONETKA_SHOP_TOKEN=
# Konto testowe: https://sandbox.furgonetka.pl → Integracje / OAuth2
# FURGONETKA_CLIENT_ID=
# FURGONETKA_CLIENT_SECRET=
# FURGONETKA_EMAIL=
# FURGONETKA_PASSWORD=
# FURGONETKA_API_URL=https://api.sandbox.furgonetka.pl
# Produkcja: usuń SANDBOX/MOCK, ustaw dane z https://furgonetka.pl
# FURGONETKA_INPOST_SERVICE_ID=
# FURGONETKA_LABEL_PAGE=a6
# LP_PARCEL_S_KG=5
# LP_PARCEL_M_KG=15
# LP_PARCEL_L_KG=25
# LP_PARCEL_MAX_KG=25

