# Backend — skopiuj do .env i uzupełnij wartości
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Single-tenant beta key (subscriptions / credits). Change per restaurant deploy.
ACCOUNT_KEY=default
# Optional: comma-separated origins; server currently allows * via CORSMiddleware
CORS_ALLOW_ORIGINS=*

# Stripe (TEST lub LIVE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_TIER1=price_...
STRIPE_PRICE_TIER2=price_...
STRIPE_PRICE_TOPUP_100=price_...
STRIPE_PRICE_TOPUP_500=price_...
STRIPE_PRICE_TOPUP_1000=price_...

PUBLIC_APP_URL=http://localhost:8081
BILLING_SUCCESS_URL=http://localhost:8081/billing-success
BILLING_CANCEL_URL=http://localhost:8081/billing-cancel
ALLOW_MOCK_BILLING=false

# Powiadomienia po opłaceniu zamówienia LP (dystrybutor)
RESEND_API_KEY=
# Musi być domena zweryfikowana w Resend (Gmail jako From zwykle odpada).
# Bez wartości backend używa onboarding@resend.dev (tylko testy).
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gastro Manager
SMSAPI_TOKEN=
SMSAPI_FROM=GastroMgr
# SMS_PROVIDER=smsapi

# Furgonetka REST API (konto platformy — prepaid / skarbonka). NIE wkładaj do apki/WWW.
# Panel: https://furgonetka.pl → Integracje / API → aplikacja OAuth2 (grant password).
FURGONETKA_CLIENT_ID=
FURGONETKA_CLIENT_SECRET=
FURGONETKA_EMAIL=
FURGONETKA_PASSWORD=
# Opcjonalnie gotowy Bearer zamiast logowania:
# FURGONETKA_ACCESS_TOKEN=
# FURGONETKA_SANDBOX=1
# FURGONETKA_API_URL=https://api.furgonetka.pl
# FURGONETKA_INPOST_SERVICE_ID=
# FURGONETKA_LABEL_PAGE=a6
# LP_PARCEL_S_KG=5
# LP_PARCEL_M_KG=15
# LP_PARCEL_L_KG=25
# LP_PARCEL_MAX_KG=25

