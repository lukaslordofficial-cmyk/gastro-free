# Publiczny URL backendu (port API = 8001).
# WAŻNE dla APK bety: musi być HTTPS osiągalny z internetu (Railway/Render/Fly/VPS).
# Adres LAN (np. http://192.168.x.x:8001) działa TYLKO w tej samej sieci Wi‑Fi.
EXPO_PUBLIC_BACKEND_URL=https://YOUR-BETA-BACKEND.example.com

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Stripe TEST (pk_test_...) — checkout idzie przez backend, nie przez ten klucz w TS
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# AdMob (produkcyjne ID-y są w adConfig.ts jako fallback)
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-...
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-...
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
# EXPO_PUBLIC_ADMOB_BANNER_IOS=
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
# EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
# EXPO_PUBLIC_ADMOB_REWARDED_IOS=
# EXPO_PUBLIC_ADMOB_USE_TEST_IDS=1
