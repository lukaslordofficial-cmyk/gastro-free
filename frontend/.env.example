# Publiczny URL backendu (port API = 8001).
# WAŻNE dla APK bety: musi być HTTPS osiągalny z internetu (Railway/Render/Fly/VPS).
# Adres LAN (np. http://192.168.x.x:8001) działa TYLKO w tej samej sieci Wi‑Fi.
EXPO_PUBLIC_BACKEND_URL=https://YOUR-BETA-BACKEND.example.com

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Stripe TEST (pk_test_...) — nie wstawiaj pk_live_ na closed beta
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
