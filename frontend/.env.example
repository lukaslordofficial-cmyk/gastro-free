# =============================================================================
# Expo — skopiuj do frontend/.env i zrestartuj Metro.
# EAS: scripts/sync-eas-preview-env.js wstawia te wartości do eas.json
# (nie commituj wypełnionego eas.json / .env).
# =============================================================================

# Publiczny HTTPS backendu (port API 8001 / Railway). NIE Metro 8081.
EXPO_PUBLIC_BACKEND_URL=https://YOUR-SERVICE.up.railway.app

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Ten sam tryb co backend: pk_test_ na betę, pk_live_ na produkcję
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
