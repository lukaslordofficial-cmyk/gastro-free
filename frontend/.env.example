# =============================================================================
# Expo — skopiuj do frontend/.env i zrestartuj Metro.
# EAS: scripts/sync-eas-preview-env.js wstawia te wartości do eas.json
# (nie commituj wypełnionego eas.json / .env).
# =============================================================================

# Publiczny HTTPS backendu (port API 8001 / Railway). NIE Metro 8081.
EXPO_PUBLIC_BACKEND_URL=https://YOUR-SERVICE.up.railway.app

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Ten sam tryb co backend: pk_live_ na produkcję (EAS sync z frontend/.env)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Reklamy AdMob — package Android/iOS: pl.gastromanager.app
# Expo Go NIGDY nie pokaże banerów — potrzebny EAS APK.
# Slot produkcyjny: Free PO zakończonym trialu 30 dni (kredyty nie włączają/wyłączają reklam).
# W AdMob Console utwórz aplikację Android z package pl.gastromanager.app,
# wklej App ID i jednostki poniżej (stary com.emergent… nie zadziała).
# Privacy & messaging → GDPR (UMP) dla EOG.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXX~YYYY
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=ca-app-pub-XXXX/ZZZZ
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-XXXX/WWWW
# Preview APK (EAS preview / preview-apk): testowe jednostki Google + slot mimo trialu
# EXPO_PUBLIC_ADMOB_USE_TEST_IDS=1
# EXPO_PUBLIC_FORCE_ADS=1
# Play Store / real ads: buduj EAS profile `production` (bez TEST_IDS / FORCE_ADS).
# Opcjonalnie live units na nie-produkcyjnym buildzie:
# EXPO_PUBLIC_ADMOB_USE_LIVE=1

