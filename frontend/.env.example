# =============================================================================
# Expo — skopiuj do frontend/.env i zrestartuj Metro.
# EAS: scripts/sync-eas-preview-env.js wstawia te wartości do eas.json
# (nie commituj wypełnionego eas.json / .env).
# =============================================================================

# Publiczny HTTPS backendu (port API 8001 / Railway). NIE Metro 8081.
EXPO_PUBLIC_BACKEND_URL=https://YOUR-SERVICE.up.railway.app

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...

# Ten sam tryb co backend: pk_live_ na produkcję (EAS sync z frontend/.env)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Reklamy AdMob
# Expo Go NIGDY nie pokaże banerów — potrzebny EAS APK / development build.
# Preview APK: w eas.json jest EXPO_PUBLIC_ADMOB_USE_TEST_IDS=1 i FORCE_ADS=1
# (testowe reklamy Google + slot nawet w czasie trialu).
# Produkcja (Play): bez tych flag — prawdziwe jednostki, reklamy tylko na Free po trialu.
# AdMob Console: https://apps.admob.google.com/ → aplikacja z package
# com.emergent.gastrovision.pkqz88 + te same App ID / Ad unit ID co w app.json.
# Privacy & messaging → GDPR (UMP) dla EOG, inaczej baner może być pusty.
# EXPO_PUBLIC_ADMOB_USE_LIVE=1  — wymuś prawdziwe jednostki nawet w __DEV__ (nie polecane)

