{
  "expo": {
    "name": "Gastro Manager",
    "slug": "gastro-manager",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gastromanager",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-image.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A120E"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Gastro Manager używa mikrofonu do głosowego raportowania strat, kosztów, produktów i dań.",
        "NSCameraUsageDescription": "Skanuj cenniki i oferty dostawców aparatem.",
        "NSPhotoLibraryUsageDescription": "Wgraj zdjęcie cennika dostawcy z galerii.",
        "NSUserTrackingUsageDescription": "Identyfikator reklamy służy do wyświetlania reklam w planie darmowym (AdMob), tylko gdy nie masz płatnego planu."
      },
      "bundleIdentifier": "pl.gastromanager.app"
    },
    "android": {
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A120E"
      },
      "usesCleartextTraffic": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "pl.gastromanager.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "gastromanager" },
            { "scheme": "gastromanager", "host": "auth" },
            { "scheme": "gastromanager", "host": "lp" },
            { "scheme": "gastromanager", "host": "billing" }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00FF78"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wgraj zdjęcie cennika dostawcy z galerii.",
          "cameraPermission": "Skanuj cenniki i oferty dostawców aparatem."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Gastro Manager używa mikrofonu do głosowego raportowania strat, kosztów, produktów i dań."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7415277897076822~9839286987",
          "iosAppId": "ca-app-pub-7415277897076822~9839286987",
          "delayAppMeasurementInit": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4873e735-f489-474d-a935-8467dab9cca2"
      }
    },
    "owner": "lukaslord"
  }
}
